POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=workspace_docs
DATABASE_URL=postgresql://app:app@postgres:5432/workspace_docs?schema=public
JWT_SECRET=change-me-for-local-development
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12
PORT=3000
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000
REDIS_URL=redis://redis:6379
CACHE_ENABLED=true
CACHE_PROJECTS_TTL_SECONDS=60
CACHE_SEARCH_TTL_SECONDS=30
CACHE_LOCK_TTL_MS=5000
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=replace-with-private-bucket-name
S3_ACCESS_KEY_ID=replace-with-service-account-static-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-service-account-static-secret-key
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_TTL_SECONDS=600
S3_DOWNLOAD_TTL_SECONDS=300
DOCUMENT_FILE_MAX_BYTES=26214400
DOCUMENT_FILE_PENDING_TTL_HOURS=24
