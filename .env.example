POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=workspace_docs
DATABASE_URL=postgresql://app:app@postgres:5432/workspace_docs?schema=public
JWT_SECRET=change-me-for-local-development
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12
PORT=3000
