{
	"moduleFileExtensions": ["js", "json", "ts"],
	"rootDir": ".",
	"testEnvironment": "node",
	"testTimeout": 30000,
	"testMatch": [
		"**/*.e2e-spec.ts",
		"!**/document-body-release-[ab].e2e-spec.ts",
		"!**/backfill-document-body.e2e-spec.ts"
	],
	"transform": {
		"^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
	}
}
