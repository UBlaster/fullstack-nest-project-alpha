generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  MEMBER
  VIEWER
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum DocumentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DocumentFileStatus {
  PENDING
  READY
  DELETING
  FAILED
}

enum ExportJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum OutboxEventType {
  EXPORT_REQUESTED
  PIPELINE_STAGE
}

enum DocumentVersionStatus {
  UPLOADED
  EXTRACTING
  NORMALIZING
  CHUNKING
  EMBEDDING
  INDEXED
  FAILED
}

enum PipelineStage {
  EXTRACT
  NORMALIZE
  CHUNK
  EMBED
  INDEX
  ACTIVATE
}

enum PipelineRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  CANCELLED
  FAILED
}

enum PaymentPurpose {
  WORKSPACE_DEMO
}

model User {
  id          String            @id @default(cuid())
  email       String            @unique
  password    String
  name        String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships WorkspaceMember[]
  projects    Project[]
  documents   Document[]
  exportJobs  ExportJob[]
  payments    Payment[]
}

model Workspace {
  id         String            @id @default(cuid())
  name       String
  status     WorkspaceStatus   @default(ACTIVE)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  members    WorkspaceMember[]
  projects   Project[]
  exportJobs ExportJob[]
  payments   Payment[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  documents   Document[]

  @@index([workspaceId])
}

model Document {
  id               String            @id @default(cuid())
  projectId        String
  authorId         String
  title            String
  body             String
  status           DocumentStatus    @default(DRAFT)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author           User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  files            DocumentFile[]
  versions         DocumentVersion[] @relation("DocumentVersions")
  currentVersionId String?           @unique
  currentVersion   DocumentVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([authorId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Document_title_trgm_idx")
}

model DocumentFile {
  id           String             @id @default(cuid())
  documentId   String
  objectKey    String             @unique
  originalName String
  mimeType     String
  size         Int
  etag         String?
  status       DocumentFileStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  document     Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versions     DocumentVersion[]

  @@index([documentId])
  @@index([status, createdAt])
}

model DocumentVersion {
  id              String                @id @default(cuid())
  documentId      String
  version         Int
  sourceFileId    String
  contentHash     String
  pipelineVersion String
  requestedById   String
  status          DocumentVersionStatus @default(UPLOADED)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  document        Document              @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentFor      Document?             @relation("CurrentVersion")
  sourceFile      DocumentFile          @relation(fields: [sourceFileId], references: [id], onDelete: NoAction)
  stages          PipelineStageRun[]
  chunks          DocumentChunk[]
  parts           DocumentTextPart[]

  @@unique([documentId, version])
  @@unique([documentId, contentHash])
  @@index([sourceFileId])
}

model PipelineStageRun {
  id          String            @id @default(cuid())
  versionId   String
  stage       PipelineStage
  inputHash   String
  status      PipelineRunStatus @default(PENDING)
  attempts    Int               @default(0)
  dispatch    Int               @default(0)
  errorCode   String?
  claimToken  String?
  heartbeatAt DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  version     DocumentVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, stage, inputHash])
  @@index([status, heartbeatAt])
}

model DocumentTextPart {
  versionId String
  stage     PipelineStage
  partIndex Int
  text      String
  version   DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@id([versionId, stage, partIndex])
}

model DocumentChunk {
  id         String              @id @default(cuid())
  versionId  String
  chunkIndex Int
  text       String
  tokenCount Int
  textHash   String
  version    DocumentVersion     @relation(fields: [versionId], references: [id], onDelete: Cascade)
  embeddings DocumentEmbedding[]

  @@unique([versionId, chunkIndex])
}

model DocumentEmbedding {
  id               String                      @id @default(cuid())
  chunkId          String
  embeddingVersion String
  model            String
  dimension        Int
  status           String                      @default("READY")
  embedding        Unsupported("vector(1024)")
  chunk            DocumentChunk               @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([chunkId, embeddingVersion])
}

model EmbeddingReadConfig {
  id               String   @id
  embeddingVersion String
  writeVersions    String[]
}

model ExportJob {
  id                String          @id
  workspaceId       String
  requestedById     String
  status            ExportJobStatus @default(QUEUED)
  filters           Json
  queueJobId        String          @unique
  objectKey         String?         @unique
  progress          Int             @default(0)
  attempts          Int             @default(0)
  heartbeatAt       DateTime?
  processingToken   String?
  errorCode         String?
  cancelRequestedAt DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  expiresAt         DateTime?
  expiredAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy       User            @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([requestedById, createdAt])
  @@index([status, heartbeatAt])
  @@index([status, expiresAt])
}

model OutboxEvent {
  id            String          @id @default(cuid())
  type          OutboxEventType
  aggregateId   String
  payload       Json
  availableAt   DateTime        @default(now())
  claimedAt     DateTime?
  claimToken    String?
  publishedAt   DateTime?
  attempts      Int             @default(0)
  lastErrorCode String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([type, aggregateId])
  @@index([publishedAt, availableAt, createdAt])
  @@index([claimedAt])
}

model Payment {
  id                     String         @id @default(uuid()) @db.Uuid
  workspaceId            String
  userId                 String
  purpose                PaymentPurpose
  provider               String         @default("stripe")
  amountMinor            Int
  currency               String
  status                 PaymentStatus  @default(CREATED)
  providerPaymentId      String?        @unique
  confirmationUrl        String?
  idempotencyKey         String         @db.Uuid
  requestHash            String
  providerIdempotenceKey String         @unique @db.Uuid
  providerRequest        Json
  firstDispatchedAt      DateTime?
  createAttempts         Int            @default(0)
  version                Int            @default(0)
  needsReview            Boolean        @default(false)
  lastErrorCode          String?
  nextReconcileAt        DateTime       @default(now())
  reconcileAttempts      Int            @default(0)
  leaseToken             String?        @db.Uuid
  leaseUntil             DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  workspace              Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user                   User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  events                 PaymentEvent[]
  audits                 PaymentAudit[]

  @@unique([userId, idempotencyKey])
  @@index([workspaceId, createdAt, id])
  @@index([status, nextReconcileAt, createdAt])
}

model PaymentEvent {
  id               String    @id @default(uuid()) @db.Uuid
  provider         String
  eventType        String
  providerObjectId String
  paymentId        String?   @db.Uuid
  result           String
  errorCode        String?
  processedAt      DateTime?
  nextReconcileAt  DateTime  @default(now())
  attempts         Int       @default(0)
  leaseToken       String?   @db.Uuid
  leaseUntil       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  payment          Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventType, providerObjectId])
  @@index([result, nextReconcileAt])
}

model PaymentAudit {
  id            String        @id @default(uuid()) @db.Uuid
  paymentId     String        @db.Uuid
  fromStatus    PaymentStatus
  toStatus      PaymentStatus
  reason        String
  correlationId String
  createdAt     DateTime      @default(now())
  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
}
